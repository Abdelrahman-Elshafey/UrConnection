# Copy to api/.env (gitignored). Values match docker-compose.yml's development defaults.
NODE_ENV=development
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://urconnections:urconnections_dev@localhost:5433/urconnections
LOG_LEVEL=debug
# Optional: database used by `npm run test:db` (must end in _test). Default:
# TEST_DATABASE_URL=postgres://urconnections:urconnections_dev@localhost:5433/urconnections_test
