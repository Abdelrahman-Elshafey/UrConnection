# Copy to api/.env (gitignored). Values match docker-compose.yml's development defaults.
NODE_ENV=development
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://urconnections:urconnections_dev@localhost:5433/urconnections
LOG_LEVEL=debug
# The website's origin. POST/PATCH/DELETE from any other origin get 403 (CSRF protection).
APP_ORIGIN=http://localhost:5173
# Outgoing email. Development: Mailpit from docker-compose.yml (read mail at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=UrConnections <no-reply@urconnections.local>
# Google sign-in (optional; leave empty to turn it off). Google Cloud console → APIs & Services →
# Credentials → Create OAuth client ID → Web application. Authorized redirect URI (exact):
#   http://localhost:5173/api/auth/google/callback      (= APP_ORIGIN + /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: database used by `npm run test:db` (must end in _test). Default:
# TEST_DATABASE_URL=postgres://urconnections:urconnections_dev@localhost:5433/urconnections_test
