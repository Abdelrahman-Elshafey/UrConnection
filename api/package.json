{
  "name": "@urconnections/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts latest",
    "db:rollback": "tsx src/db/migrate.ts down",
    "db:reset": "tsx src/db/migrate.ts reset",
    "db:seed": "tsx src/db/seed.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@urconnections/shared": "*",
    "arctic": "^3.7.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
