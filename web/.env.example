# Copy to web/.env and fill in. Never commit web/.env.
# Values: Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
# Where Google OAuth returns after sign-in (must be in Supabase → Auth → URL Configuration).
VITE_AUTH_REDIRECT_URL=http://localhost:5173
