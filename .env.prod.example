# Settings for compose.prod.yml. Copy to .env.prod, or let `npm run prod:env` create it
# with fresh random secrets. .env.prod is gitignored: NEVER commit it.
# Values here work for running the production stack on your own computer
# (https://localhost). Stage 14 sets the real domain and mail provider.

# ── Site ──
# The address Caddy serves and gets a certificate for: localhost, or your domain.
SITE_ADDRESS=localhost
# Scheme + host (+ port if not 443). The API only accepts writes from this origin (CSRF),
# and uses it for links in emails and for the Google redirect URI.
APP_ORIGIN=https://localhost
# Ports published on the host. Change if 80/443 are taken (then add the port to APP_ORIGIN).
HTTP_PORT=80
HTTPS_PORT=443

# ── Database ──
POSTGRES_USER=urconnections
POSTGRES_DB=urconnections
# Letters and digits only (it is part of a postgres:// URL).
POSTGRES_PASSWORD=__RANDOM_HEX_32__

# ── File storage (Garage) ──
S3_BUCKET=urconnections
# Garage key format: "GK" + 24 hex characters; secrets are 64 hex characters.
S3_ACCESS_KEY_ID=GK__RANDOM_HEX_12__
S3_SECRET_ACCESS_KEY=__RANDOM_HEX_32__
GARAGE_RPC_SECRET=__RANDOM_HEX_32__

# ── Email ──
# On your computer: the dev Mailpit (npm run db:up), reached from inside Docker through
# host.docker.internal; read the mail at http://localhost:8025.
# On a server: your mail provider, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=smtp://host.docker.internal:1025
MAIL_FROM=UrConnections <no-reply@urconnections.local>

# ── Google sign-in (optional: leave both empty to turn it off) ──
# Redirect URI to register in Google Cloud: APP_ORIGIN + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Off-site backups (server only, see docs/SERVER_SETUP.md §10) ──
# Uncomment on the server to start the "offsite" service, which copies every backup to an
# S3-compatible bucket at another company (Cloudflare R2). Leave it commented on your computer.
# COMPOSE_PROFILES=offsite
# R2: https://<account-id>.r2.cloudflarestorage.com (Cloudflare → R2 → the bucket → Settings)
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_KEEP_DAYS=30

# ── Misc ──
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
