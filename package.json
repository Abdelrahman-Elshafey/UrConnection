{
  "name": "urconnections",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w @urconnections/web",
    "dev:api": "npm run dev -w @urconnections/api",
    "build": "npm run build -w @urconnections/web",
    "preview": "npm run preview -w @urconnections/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate -w @urconnections/api",
    "db:rollback": "npm run db:rollback -w @urconnections/api",
    "db:reset": "npm run db:reset -w @urconnections/api",
    "db:seed": "npm run db:seed -w @urconnections/api",
    "test:db": "npm run test:db -w @urconnections/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
